@model List<Taskitem>
<h1>Task items</h1>

<table class = "table table-hover table-bordered">
		<tr>
			<th>Id</th>
			<th>Title</th>
			<th>Description</th>
			<th>IsCompleted</th>
			<th>CreatedAt</th>
			<th>DueDate</th>
		</tr>

	@foreach(var item in Model)
	{
		<tr>
			<td>@item.Id</td>
			<td>@item.Title</td>
			<td>@item.Description</td>
			<td>@item.IsCompleted</td>
			<td>@item.CreatedAt</td>
			<td>@item.DueDate</td>
		</tr>
	}
</table>